    },
    {
      "title": "Trial 001 · Contact slips",
      "text": "The motion reference drives SONIC’s frozen whole-body policy while the generated controller manages contact. With the initial controller, the stand slips from the grasp and falls.",
      "nodes": ["policy", "controller", "trial-001"], "edges": ["motion", "code"], "clips": ["trial-001"]
    },
    {
      "title": "Simulation feedback",
      "text": "After each trial, the agent inspects images of the execution, object-tracking errors and contact measurements, then revises its code.",
      "nodes": ["agent"], "edges": ["feedback"], "clips": []
    },
    {
      "title": "Trial 007 · Contact holds",
      "text": "A revised grip and body coordination keep the stand in hand as G1 lifts and carries it.",
      "nodes": ["policy", "controller", "trial-007"], "edges": ["motion", "code"], "clips": ["trial-007"]
    },
    {
      "title": "Simulation feedback",
      "text": "The agent keeps revising between trials. Later versions add feedback and placement and release logic.",
      "nodes": ["agent"], "edges": ["feedback"], "clips": []
